---
/**
 * El riel: toda la navegación del sitio, en una franja a la izquierda.
 *
 * No hay cabecera. La marca, las herramientas, el idioma y el tema viven
 * aquí, y esa altura que antes ocupaba una barra superior se la queda el
 * contenido.
 *
 * Es HTML de verdad —enlaces, no botones con JavaScript— porque es
 * navegación: tiene que funcionar aunque el JavaScript no llegue. Abrirlo
 * al pasar por encima lo hace el CSS. Solo dos cosas necesitan un script, y
 * las dos son prescindibles: dejarlo fijado y el lanzador de todas las
 * herramientas.
 *
 * Las herramientas se agrupan por su primer ámbito, para que ninguna salga
 * dos veces. Ver src/i18n/labels.ts.
 */
import Icono from './Icono.astro';
import ThemeToggle from './ThemeToggle';
import { UI } from '../i18n/ui';
import { TOOLS } from '../i18n/tools';
import { AMBITOS, ORDEN_AMBITOS, ambitoPrincipal, type AmbitoKey } from '../i18n/labels';
import { t, otherLang, LANG_NAME, type Lang } from '../i18n/config';
import { route, TOOL_KEYS, type PageKey, type ToolKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const other = otherLang(lang);

/** Las herramientas de cada ámbito, en el orden en que se declaran. */
const grupos = ORDEN_AMBITOS.map((ambito: AmbitoKey) => ({
  ambito,
  herramientas: TOOL_KEYS.filter((key) => ambitoPrincipal(TOOLS[key].etiquetas) === ambito),
})).filter((grupo) => grupo.herramientas.length > 0);

const actual = (key: ToolKey | 'home') => (page === key ? 'page' : undefined);
---

<nav class="riel" aria-label={t(UI.navTools, lang)}>
  <a href={route('home', lang)} class="riel-fila riel-marca" aria-current={actual('home')}>
    <Icono nombre="marca" class="text-brand" />
    <span class="riel-texto">{t(UI.brand, lang)}</span>
  </a>

  {
    grupos.map((grupo) => (
      <>
        <p class="riel-grupo riel-texto">{t(AMBITOS[grupo.ambito], lang)}</p>
        <ul>
          {grupo.herramientas.map((key) => (
            <li>
              <a href={route(key, lang)} class="riel-fila" aria-current={actual(key)}>
                <Icono nombre={TOOLS[key].icono} />
                <span class="riel-texto">{t(TOOLS[key].name, lang)}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    ))
  }

  <div class="riel-pie">
    {/* Sin JavaScript este botón no hace nada, así que nace oculto y el
        script lo enseña. Mejor que no esté a que esté y no responda. */}
    <button type="button" class="riel-fila w-full cursor-pointer" data-bento hidden>
      <Icono nombre="rejilla" />
      <span class="riel-texto">{t(UI.verTodas, lang)}</span>
    </button>

    <a
      href={route(page, other)}
      class="riel-fila"
      lang={other}
      hreflang={other}
      title={t(UI.switchLanguage, lang)}
    >
      <span aria-hidden="true" class="grid size-5 place-items-center text-[0.7rem] font-semibold">
        {other.toUpperCase()}
      </span>
      <span class="riel-texto">{LANG_NAME[other]}</span>
    </a>

    <ThemeToggle client:load toDark={t(UI.toDarkMode, lang)} toLight={t(UI.toLightMode, lang)} />

    <button
      type="button"
      class="riel-fila riel-solo-escritorio w-full cursor-pointer"
      data-fijar
      data-texto-soltar={t(UI.soltarMenu, lang)}
      aria-pressed="false"
      hidden
    >
      <Icono nombre="panel" />
      <span class="riel-texto" data-fijar-texto>{t(UI.fijarMenu, lang)}</span>
    </button>
  </div>
</nav>

{/* El lanzador. Un <dialog> nativo: se cierra con Escape, atrapa el foco y
    devuelve el foco al botón al cerrarse, todo sin escribir una línea. */}
<dialog class="bento" data-bento-dialog aria-labelledby="bento-titulo">
  <div class="flex items-center justify-between gap-4 border-b border-line px-6 py-4">
    <h2 id="bento-titulo" class="text-[length:var(--fs-h3)] font-semibold text-ink">
      {t(UI.todasLasHerramientas, lang)}
    </h2>
    <button
      type="button"
      class="grid size-8 cursor-pointer place-items-center rounded-md text-ink-muted hover:bg-surface-2 hover:text-ink"
      data-bento-cerrar
    >
      <Icono nombre="cerrar" titulo={t(UI.cerrar, lang)} />
    </button>
  </div>

  <div class="grid gap-6 p-6">
    {
      grupos.map((grupo) => (
        <section>
          <h3 class="text-[0.68rem] font-semibold tracking-[0.06em] text-ink-soft uppercase">
            {t(AMBITOS[grupo.ambito], lang)}
          </h3>
          <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {grupo.herramientas.map((key) => (
              <li>
                <a
                  href={route(key, lang)}
                  class="group flex h-full gap-3 rounded-lg border border-line p-4 hover:border-brand"
                >
                  <Icono nombre={TOOLS[key].icono} class="mt-0.5 shrink-0 text-brand" />
                  <span class="min-w-0">
                    <span class="block font-medium text-ink group-hover:text-brand">
                      {t(TOOLS[key].name, lang)}
                    </span>
                    <span class="mt-1 block text-[var(--fs-small)] text-ink-muted">
                      {t(TOOLS[key].summary, lang)}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</dialog>
