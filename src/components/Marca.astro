---
/**
 * El logotipo: la pill con DGO calado, y «Tools» al lado.
 *
 * Es exactamente la marca del `public/og.png`, así que lo que alguien ve
 * al compartir un enlace y lo que se encuentra al abrirlo son la misma
 * cosa. El trazo de la pill es el mismo de `public/favicon.svg`: una sola
 * forma con las tres letras caladas, no un icono con texto encima.
 *
 * Se pinta con `currentColor`, así que hereda el color del sitio y
 * funciona igual en claro y en oscuro sin declarar nada.
 */
interface Props {
  /** Alto de la pill en píxeles. La anchura sale de su proporción. */
  alto?: number;
  class?: string;
}

const { alto = 22, class: clase } = Astro.props;

// La pill mide 88 × 48 en su lienzo original.
const ancho = Math.round((alto * 88) / 48);
---

<span class:list={['inline-flex items-center gap-2', clase]}>
  <svg
    width={ancho}
    height={alto}
    viewBox="0 0 88 48"
    fill="currentColor"
    role="img"
    aria-label="DGO Tools"
  >
    <path
      d="M64 0C77.2548 0 88 10.7452 88 24C88 37.2548 77.2548 48 64 48H24C10.7452 48 0 37.2548 0 24C0 10.7452 10.7452 3.86555e-07 24 0H64ZM43.1436 14.4561C37.3197 14.4561 33.7081 18.3199 33.708 24.5078C33.708 30.6957 37.3195 34.5038 42.6953 34.5039C44.8793 34.5039 46.7273 33.7197 47.9033 32.0957L48.3232 34H51.7119V23.5283H43.6475V27.3076H46.8672C46.5312 29.4355 44.9918 30.3319 43.1719 30.332C40.5119 30.332 38.9434 28.1758 38.9434 24.5078C38.9434 20.8399 40.4279 18.6279 43.0039 18.6279C44.7397 18.628 45.9156 19.524 46.3916 21.2598H51.7393C50.9272 16.752 47.3715 14.4561 43.1436 14.4561ZM62.3711 14.4561C56.3792 14.4561 52.6544 18.3199 52.6543 24.5078C52.6543 30.6678 56.3791 34.5039 62.3711 34.5039C68.3628 34.5037 72.0869 30.6677 72.0869 24.5078C72.0868 18.3201 68.3628 14.4562 62.3711 14.4561ZM15.54 14.96V34H23.2119C29.2879 34 33.04 30.4158 33.04 24.5078C33.04 18.5999 29.2878 14.96 23.2119 14.96H15.54ZM62.3711 18.6279C65.2268 18.6282 66.8505 20.8401 66.8506 24.5078C66.8506 28.1476 65.2268 30.3318 62.3711 30.332C59.5431 30.332 57.8906 28.1478 57.8906 24.5078C57.8907 20.8399 59.5431 18.6279 62.3711 18.6279ZM23.2119 19.1035C26.1239 19.1035 27.8036 21.0919 27.8037 24.5078C27.8037 27.9238 26.1239 29.8564 23.2119 29.8564H20.6641V19.1035H23.2119Z"
    ></path>
  </svg>

  {/*
    «Tools» no se traduce: es parte del nombre, no una palabra de la
    interfaz. En la versión en inglés dice exactamente lo mismo.
    El `aria-label` del SVG ya dice «DGO Tools», así que este texto sobra
    para quien usa un lector de pantalla.
  */}
  <span aria-hidden="true" class="font-semibold tracking-[-0.02em]" style={`font-size: ${alto * 0.82}px`}>
    Tools
  </span>
</span>
