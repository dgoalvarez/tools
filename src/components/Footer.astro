---
/**
 * Pie: la promesa de privacidad y la firma. Nada más.
 *
 * La promesa va aquí, a la vista, y no en una página de política: no hay
 * nada que politizar cuando no se recoge nada.
 *
 * La atribución a GeoNames NO está aquí. Vive en la página de husos
 * horarios, que es la única que usa esos datos. Ponerla en todas las
 * páginas no cumplía mejor la licencia —CC BY pide atribuir donde se usa la
 * obra— y sí obligaba a quien mira una escala tipográfica a leer una nota
 * sobre códigos postales.
 */
import { UI } from '../i18n/ui';
import { t, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-line">
  <div
    class="mx-auto flex max-w-[1680px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-[var(--pad-x)] py-[1.125rem] text-[var(--fs-small)] text-ink-soft"
  >
    <p class="min-w-0 flex-1">{t(UI.privacyNote, lang)}</p>

    <p>
      {t(UI.madeBy, lang)}{' '}
      <a
        href="https://dgoalvarez.com"
        class="text-ink-muted underline underline-offset-2 hover:text-brand"
      >
        {t(UI.brand, lang)}
      </a>
      <span aria-hidden="true"> · </span>
      <span>{year}</span>
    </p>
  </div>
</footer>
