---
/**
 * El tablero.
 *
 * Casi no hay texto, y es la idea: esta vista la construye quien la usa,
 * así que lo que hay que explicar se explica en el paso a paso y no en la
 * pantalla.
 *
 * Lo único escrito que se queda es la línea de dónde se guarda, y esa no
 * es opcional: la regla de la casa dice que si el sitio guarda algo, la
 * pantalla lo dice. Va abajo y en pequeño —no es una advertencia, es una
 * ficha técnica— y sale del servidor, así que se puede leer antes de que
 * la isla monte nada.
 *
 * Las dos anclas firmes del paso a paso —el hueco vacío y el botón de
 * añadir— las pinta la isla y existen desde el primer render, que es lo
 * que `check-tour` va a buscar en el HTML publicado.
 */
import Tool from '../layouts/Tool.astro';
import Tablero from '../islands/tablero/Tablero';
import { TABLERO_TEXTOS as TX } from '../i18n/tablero';
import { UI } from '../i18n/ui';
import { t, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Tool lang={lang} tool="board" compacta>
  <Tablero client:load lang={lang} />

  <p class="nota-guardado">{t(TX.aviso, lang)}</p>

  <noscript>
    <p
      class="mt-6 max-w-[var(--measure)] rounded-lg border border-line bg-surface-2 p-4 text-[length:var(--fs-small)] text-ink-muted"
    >
      {t(UI.sinJs, lang)}
    </p>
  </noscript>
</Tool>
