---
/**
 * La portada.
 *
 * Sin barra lateral y sin tope de 1152 px: es la pantalla que se mira
 * entera, así que el relleno crece con la ventana en vez de dejar una
 * franja muerta a los lados.
 *
 * Las tarjetas miden todas lo mismo y cada una se pinta con el acento de
 * su materia. El halo de color va al 16 % por un motivo medido, no
 * estético: al 42 % la etiqueta de ámbito que va encima se quedaba en
 * 1,45:1. El color de la tarjeta lo lleva ahora el borde, que no tiene
 * texto delante.
 *
 * Todo sale de src/i18n/tools.ts y src/i18n/labels.ts. Añadir una
 * herramienta ahí la añade aquí sin tocar este archivo.
 */
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { UI } from '../i18n/ui';
import { TOOLS } from '../i18n/tools';
import { MATERIAS, TAREAS, ACENTO_POR_MATERIA } from '../i18n/labels';
import { t, type Lang } from '../i18n/config';
import { route, TOOL_KEYS } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Base
  lang={lang}
  page="home"
  title={t(UI.homeTitle, lang)}
  description={t(UI.siteDescription, lang)}
>
  <div class="mx-auto max-w-[1680px] px-[var(--pad-x)]">
    <section
      class="flex flex-wrap items-end gap-x-[clamp(2rem,4vw,6rem)] gap-y-8 py-[clamp(3rem,5.6vw,7rem)]"
    >
      <h1
        class="m-0 flex-[1_1_32rem] text-[length:clamp(3rem,5.6vw,6.75rem)] leading-[0.94] font-semibold tracking-[-0.048em] text-ink text-balance"
      >
        {t(UI.taglineInicio, lang)}{' '}
        <em class="text-[var(--acento)] not-italic">{t(UI.taglineAcento, lang)}</em>
      </h1>

      <div class="flex flex-[0_1_21rem] flex-col gap-3.5">
        <p class="m-0 text-[0.72rem] font-medium tracking-[0.1em] text-ink-soft uppercase">
          {t(UI.sello, lang)}
        </p>
        <p class="m-0 text-[1rem] leading-relaxed text-ink-muted">{t(UI.homeIntro, lang)}</p>
      </div>
    </section>

    <p
      class="m-0 mb-[1.125rem] flex items-center gap-3.5 text-[0.72rem] font-medium tracking-[0.12em] text-ink-soft uppercase after:h-px after:flex-1 after:bg-line after:content-['']"
    >
      {t(UI.navTools, lang)}
    </p>

    {/* Todas del mismo alto: lo garantiza la rejilla, y el alto mínimo
        crece con la ventana para que en un monitor ganen alto y no solo
        anchura. */}
    <ul class="grid gap-[clamp(0.875rem,1.4vw,1.375rem)] pb-[clamp(1.75rem,3vw,3rem)] md:grid-cols-3">
      {
        TOOL_KEYS.map((key) => {
          const tool = TOOLS[key];
          return (
            <li class="h-full" style={`--acento: ${ACENTO_POR_MATERIA[tool.etiquetas.materia]}`}>
              <a
                href={route(key, lang)}
                class="group relative flex h-full min-h-[clamp(15.75rem,19vw,23rem)] flex-col gap-3 overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--acento)_28%,var(--line))] bg-[linear-gradient(160deg,var(--surface-2),var(--surface)_62%)] p-6 before:pointer-events-none before:absolute before:inset-[-40%_55%_55%_-20%] before:bg-[radial-gradient(closest-side,var(--acento),transparent)] before:opacity-[0.16] before:content-['']"
              >
                <span class="relative text-[0.72rem] font-medium tracking-[0.1em] text-ink-muted uppercase">
                  {t(MATERIAS[tool.etiquetas.materia], lang)}
                </span>

                <span class="relative grid size-11 place-items-center rounded-xl bg-[var(--acento)] text-[var(--brand-ink)]">
                  <Icono nombre={tool.icono} tamano={24} />
                </span>

                <h2 class="relative m-0 text-[length:clamp(1.4rem,1.7vw,1.875rem)] font-semibold tracking-[-0.032em] text-ink">
                  {t(tool.name, lang)}
                </h2>

                <span class="relative flex-1 text-[0.9rem] leading-relaxed text-ink-muted">
                  {t(tool.summary, lang)}
                </span>

                <span class="relative flex items-center gap-2 text-[0.72rem] font-medium tracking-[0.06em] text-ink-soft uppercase">
                  {t(TAREAS[tool.etiquetas.tarea], lang)}
                  {tool.listo ? (
                    <span class="ml-auto text-[var(--acento)] group-hover:underline">
                      {t(UI.openTool, lang)} <span aria-hidden="true">→</span>
                    </span>
                  ) : (
                    <span class="ml-auto">{t(UI.soonBadge, lang)}</span>
                  )}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</Base>
