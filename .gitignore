.claude/settings.local.json

# logs
*.log
npm-debug.log*
.geonames/

# Maquetas de las propuestas de diseño (el entregable es el lienzo publicado)
design/

# …pero las derivaciones de color sí: son el origen medido de los tokens
# que están en global.css, y sin ellas los valores parecen elegidos a ojo.
!design/*.ts

# Los lienzos de propuestas se publican, no se versionan
design-propuestas/

# El lienzo de propuestas se publica, no se versiona (3 MB)
home-y-navegacion-cuatro-direcciones.html
dgo-tools-editorial-oscuro.html

# Capturas de verificación (se regeneran con npm run ver)
capturas/

# El grafo de graphify.
#
# Se versiona lo que evita repetir la extracción —el informe, el grafo, el
# manifiesto y la caché— porque construirlo costó 215.000 tokens y sin eso
# cada revisión lo pagaría otra vez. Fuera se quedan el HTML, que sale de
# graph.json con `graphify export html`, y los dos sidecars, que llevan
# rutas de ESTA máquina.
graphify-out/graph.html
graphify-out/.graphify_python
graphify-out/.graphify_root
