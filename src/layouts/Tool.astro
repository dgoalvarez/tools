---
/**
 * El envoltorio común de una herramienta: título, qué resuelve, y hueco
 * para la herramienta en sí.
 *
 * Sin migas de pan: la barra lateral ya dice dónde estás y cuál está
 * abierta, así que repetirlo arriba sería decir dos veces lo mismo.
 *
 * El nombre y la descripción no se escriben aquí ni en cada página: salen
 * de src/i18n/tools.ts, que es de donde salen también las tarjetas de la
 * portada. Así no puede haber una herramienta que se llame de dos formas.
 */
import Base from './Base.astro';
import Tour from '../islands/Tour';
import { UI } from '../i18n/ui';
import { TOOLS } from '../i18n/tools';
import { t, type Lang } from '../i18n/config';
import type { ToolKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  tool: ToolKey;
}

const { lang, tool } = Astro.props;
const meta = TOOLS[tool];

const name = t(meta.name, lang);
const description = t(meta.description, lang);
---

<Base lang={lang} page={tool} title={`${name} · ${t(UI.brand, lang)} Tools`} description={description}>
  <div class="mx-auto max-w-[1560px] px-[var(--pad-x)] py-[clamp(1.75rem,3vw,3.25rem)]">
    {/*
      El título y lo que resuelve van en la misma línea cuando hay sitio:
      juntos son una frase, y separarlos en dos bloques hacía que el
      resumen pareciera un párrafo suelto.
    */}
    <header class="flex flex-wrap items-end gap-x-8 gap-y-2.5">
      <h1
        class="m-0 text-[length:clamp(2.375rem,3.4vw,4rem)] leading-[0.96] font-semibold tracking-[-0.042em] text-ink"
      >
        {name}
      </h1>
      <p class="m-0 max-w-[46ch] text-[0.95rem] leading-relaxed text-ink-muted">
        {t(meta.summary, lang)}
      </p>

      {/* El paso a paso, en la esquina. Sustituye al cajón de «¿Cómo
          funciona?» que vivía abajo del todo: explicaba los controles
          lejos de los controles, y por eso casi nadie lo abría. */}
      <div class="ml-auto">
        <Tour client:load lang={lang} tool={tool} />
      </div>
    </header>

    <div class="mt-[clamp(1.25rem,2vw,2.125rem)]">
      <slot />
    </div>
  </div>
</Base>
