---
/**
 * El envoltorio común de una herramienta.
 *
 * El encabezado va en tres renglones y no en una fila:
 *
 *   TIEMPO                                    ? Cómo funciona
 *   Husos horarios
 *   Di tu hora en la hora del otro, sin equivocarte de día.
 *   ────────────────────────────────────────────────────────
 *
 * Antes el título y el resumen iban uno al lado del otro alineados por
 * abajo. Se leía como dos cosas puestas juntas y no como un bloque: el
 * resumen colgaba de la línea base del título, a una altura distinta según
 * lo ancha que fuera la ventana, y el botón de ayuda saltaba de renglón
 * sin avisar en cuanto el nombre crecía.
 *
 * En tres renglones hay un solo eje y todo cuelga del mismo margen. La
 * ayuda está siempre en el mismo sitio, mida lo que mida el nombre.
 *
 * El rótulo de materia sale de las mismas etiquetas que agrupan la portada
 * y la barra lateral, y se pinta con el acento de esa materia — medido y
 * no elegido a ojo: `scripts/comprobar-encabezado.ts` lo comprueba en los
 * dos temas y contra los dos fondos sobre los que puede caer.
 *
 * Sin migas de pan: la barra lateral ya dice dónde estás.
 *
 * El nombre y el resumen no se escriben aquí ni en cada página: salen de
 * src/i18n/tools.ts, que es de donde salen también las tarjetas de la
 * portada. Así no puede haber una herramienta que se llame de dos formas.
 */
import Base from './Base.astro';
import Tour from '../islands/Tour';
import { UI } from '../i18n/ui';
import { TOOLS } from '../i18n/tools';
import { MATERIAS } from '../i18n/labels';
import { t, type Lang } from '../i18n/config';
import type { ToolKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  tool: ToolKey;
}

const { lang, tool } = Astro.props;
const meta = TOOLS[tool];

const name = t(meta.name, lang);
const description = t(meta.description, lang);
---

<Base
  lang={lang}
  page={tool}
  title={`${name} · ${t(UI.brand, lang)} Tools`}
  description={description}
>
  <div class="mx-auto max-w-[1560px] px-[var(--pad-x)]">
    <header class="cabecera">
      <div class="cabecera-fila">
        <p class="cabecera-materia">{t(MATERIAS[meta.etiquetas.materia], lang)}</p>
        <Tour client:load lang={lang} tool={tool} />
      </div>

      <h1 class="cabecera-titulo">{name}</h1>

      <p class="cabecera-resumen">{t(meta.summary, lang)}</p>
    </header>

    <div class="pb-[clamp(2rem,4vw,4rem)]">
      <slot />
    </div>
  </div>
</Base>
