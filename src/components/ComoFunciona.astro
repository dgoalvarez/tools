---
/**
 * El cajón donde vive lo que explica una herramienta sin estorbarla.
 *
 * La regla para decidir qué va aquí dentro y qué se queda fuera es una
 * sola: **fuera solo lo que cambia una decisión ahora mismo.** El aviso de
 * que la cita cae en otro día se queda a la vista; la explicación de hasta
 * dónde llega un código postal se pliega aquí.
 *
 * Es un `<details>` nativo y no un acordeón de React, y no por ahorrar:
 *
 *   · Se abre y se cierra sin JavaScript.
 *   · Los lectores de pantalla ya saben anunciarlo, sin ARIA escrito a mano.
 *   · Ctrl+F encuentra lo que hay dentro aunque esté cerrado, porque los
 *     navegadores abren el `<details>` al buscar. Un div con `display:none`
 *     no aparece en esa búsqueda, y entonces la explicación es como si no
 *     existiera.
 */
import { UI } from '../i18n/ui';
import { t, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<details class="mt-10 max-w-[var(--measure)] rounded-lg border border-line">
  <summary
    class="cursor-pointer list-none px-4 py-3 text-[var(--fs-small)] font-medium text-ink-muted marker:content-none hover:text-ink"
  >
    <span
      class="inline-block transition-transform group-open:rotate-90"
      aria-hidden="true">›</span
    >
    {t(UI.comoFunciona, lang)}
  </summary>

  <div
    class="grid gap-4 border-t border-line px-4 py-4 text-[var(--fs-small)] text-ink-muted [&_h3]:font-semibold [&_h3]:text-ink [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-brand"
  >
    <slot />
  </div>
</details>
