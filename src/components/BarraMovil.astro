---
/**
 * La navegación de móvil: una barra fina arriba y una hoja que entra por
 * la izquierda.
 *
 * ---------------------------------------------------------------------
 * Por qué se va la barra de abajo
 *
 * Lo que había era una fila de iconos pegada al borde inferior, con una
 * ficha por herramienta. Con tres funcionaba; con seis, cada ficha se
 * quedó en 55 px y «Escala tipográfica» tuvo que partirse en dos líneas.
 * Con ocho no cabe, y la salida sería truncar los nombres — o sea,
 * quitarles justo lo que servía.
 *
 * Una hoja no tiene ese techo: crecer solo la hace más larga.
 *
 * ---------------------------------------------------------------------
 * Por qué un `<dialog>` y no un div
 *
 * Lo trae todo hecho y bien: atrapa el foco dentro, cierra con Escape,
 * devuelve el foco al botón que lo abrió y marca el resto de la página
 * como inerte. Escrito a mano, cada una de esas cuatro cosas es un fallo
 * de accesibilidad esperando.
 *
 * La hoja entra por la IZQUIERDA, que es donde vive la navegación en
 * todas partes. El botón que la abre, en cambio, va a la DERECHA de la
 * barra: es el lado que alcanza el pulgar sin recolocar el teléfono.
 */
import Icono from './Icono.astro';
import Marca from './Marca.astro';
import NavHerramientas from './NavHerramientas.astro';
import ThemeToggle from './ThemeToggle';
import { UI } from '../i18n/ui';
import { t, otherLang, LANG_NAME, type Lang } from '../i18n/config';
import { route, type PageKey, type ToolKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  abierta: ToolKey | null;
  pagina: PageKey;
}

const { lang, abierta, pagina } = Astro.props;
const other = otherLang(lang);
---

<header class="barra-movil">
  <a href={route('home', lang)} class="marca-movil">
    <Marca />
  </a>

  {/* Se esconde desde el CSS mientras `data-js` no esté en el <html>: sin
      JavaScript no abriría la hoja, y la página sigue siendo navegable
      porque la portada lista todas las herramientas y el pie lleva a ella.
      Lo decide el script en línea, antes del primer pintado, para que la
      barra no cambie de forma nada más cargar. */}
  <button
    type="button"
    class="pastilla cursor-pointer solo-con-js"
    data-hoja-abrir
    aria-label={t(UI.abrirMenu, lang)}
  >
    <Icono nombre="barras" tamano={18} />
  </button>
</header>

<dialog class="hoja" data-hoja aria-label={t(UI.navTools, lang)}>
  {/* Misma división que en el riel: marca y buscador arriba, separados de
      las herramientas por una línea, y los ajustes al pie por otra. */}
  <div class="hoja-inicio">
    <div class="hoja-cabecera">
      <a href={route('home', lang)} class="riel-logo">
        <Marca />
      </a>
      <button
        type="button"
        class="pastilla cursor-pointer"
        data-hoja-cerrar
        aria-label={t(UI.cerrarMenu, lang)}
      >
        <Icono nombre="cerrar" tamano={16} />
      </button>
    </div>

    <button type="button" class="riel-item cursor-pointer" data-bento>
      <span class="icono"><Icono nombre="lupa" tamano={18} /></span>
      <span class="nombre">{t(UI.verTodas, lang)}</span>
    </button>
  </div>

  <div class="hoja-lista">
    <NavHerramientas lang={lang} abierta={abierta} />
  </div>

  <div class="hoja-pie">
    <a href={route(pagina, other)} class="riel-item" lang={other} hreflang={other}>
      <span class="icono idioma">{LANG_NAME[other].slice(0, 2)}</span>
      <span class="nombre">{LANG_NAME[other]}</span>
    </a>

    <ThemeToggle
      client:load
      toDark={t(UI.toDarkMode, lang)}
      toLight={t(UI.toLightMode, lang)}
      conNombre
    />
  </div>
</dialog>
