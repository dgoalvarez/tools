---
/**
 * La barra de la portada: fina, y nada más que lo imprescindible.
 *
 * La portada no lleva barra lateral a propósito. Es la pantalla que se
 * mira entera, y una columna fija a la izquierda le quitaría justo el
 * ancho que necesita para que las herramientas se vean bien.
 */
import Icono from './Icono.astro';
import Marca from './Marca.astro';
import ThemeToggle from './ThemeToggle';
import { UI } from '../i18n/ui';
import { t, otherLang, LANG_NAME, type Lang } from '../i18n/config';
import { route } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other = otherLang(lang);
---

<header class="barra-superior mx-auto max-w-[1680px] px-[var(--pad-x)]">
  <a href={route('home', lang)} aria-current="page" class="hover:text-[var(--acento)]">
    <Marca />
  </a>

  <div class="ml-auto flex items-center gap-2">
    {/* Nace oculto: sin JavaScript no abriría nada. */}
    <button type="button" class="pastilla cursor-pointer" data-bento hidden>
      <Icono nombre="lupa" tamano={16} />
      <span class="solo-escritorio">{t(UI.irAHerramienta, lang)}</span>
      <kbd class="solo-escritorio" data-atajo>⌘K</kbd>
    </button>

    <a
      href={route('home', other)}
      class="pastilla"
      lang={other}
      hreflang={other}
      title={t(UI.switchLanguage, lang)}
    >
      {LANG_NAME[other]}
    </a>

    <ThemeToggle client:load toDark={t(UI.toDarkMode, lang)} toLight={t(UI.toLightMode, lang)} />
  </div>
</header>
