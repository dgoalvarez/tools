---
/**
 * La página de la herramienta de husos horarios.
 *
 * `client:load` para que el HTML salga ya pintado del servidor y no haya un
 * hueco en blanco mientras carga el JavaScript.
 *
 * Todo lo que explicaba la herramienta vivía plegado en un «¿Cómo
 * funciona?» al final. Ahora lo cuenta el paso a paso del botón «?», que
 * lo explica señalando el control en vez de describirlo aquí abajo.
 *
 * ---------------------------------------------------------------------
 * Por qué la nota de los datos se pliega pero no desaparece
 *
 * Lo de abajo no es un descargo que se pueda quitar: es la atribución
 * que exige la licencia CC BY 4.0 de GeoNames, y la exige **donde se usa
 * la obra**. Por eso vive aquí y no en el pie del sitio, y por eso está
 * impresa en el HTML y no dentro del paso a paso, que necesita
 * JavaScript.
 *
 * La forma de plegarla sin incumplir es esta: el resumen —que se ve
 * siempre, abierto o cerrado— nombra la fuente y la licencia, que es lo
 * que la licencia pide identificar. Lo que se pliega es la explicación
 * de hasta dónde llega la precisión, que sí es opcional, más los enlaces.
 *
 * Es un `<details>` nativo, así que se abre sin JavaScript y Ctrl+F lo
 * encuentra aunque esté cerrado: los navegadores lo abren al buscar
 * dentro. Un div con `display: none` no aparecería en esa búsqueda, y
 * entonces la atribución sería como si no existiera.
 */
import Tool from '../layouts/Tool.astro';
import Timezones from '../islands/Timezones';
import { UI } from '../i18n/ui';
import { HUSOS } from '../i18n/timezones';
import { t, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Tool lang={lang} tool="timezones">
  <Timezones client:load lang={lang} />

  <noscript>
    <p
      class="mt-6 max-w-[var(--measure)] rounded-lg border border-line bg-surface-2 p-4 text-[var(--fs-small)] text-ink-muted"
    >
      {t(UI.sinJs, lang)}
    </p>
  </noscript>

  <details data-tour="precision" class="nota-datos">
    <summary>{t(HUSOS.fuenteResumen, lang)}</summary>

    <div class="cuerpo">
      <p>{t(HUSOS.precisionCuerpo, lang)}</p>
      <p>
        {t(HUSOS.atribucion, lang)}{' '}
        <a href="https://www.geonames.org" rel="noopener">GeoNames</a>
        <span aria-hidden="true"> · </span>
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener">CC BY 4.0</a>
      </p>
    </div>
  </details>
</Tool>
