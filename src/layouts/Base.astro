---
/**
 * Estructura común de todas las páginas: <head>, cabecera, contenido y pie.
 *
 * Cada página existe en un solo idioma, declarado en <html lang>, y apunta
 * a su equivalente en el otro mediante hreflang.
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { UI } from '../i18n/ui';
import { t, otherLang, OG_LOCALE, DEFAULT_LANG, LANGS, type Lang } from '../i18n/config';
import { route, type PageKey } from '../i18n/routes';
import '../styles/global.css';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;

const site = Astro.site!;
const canonical = new URL(route(page, lang), site).href;

// Cada página declara dónde vive su equivalente en el otro idioma, y cuál
// es la que se muestra a quien no encaja en ninguno (x-default).
const alternates = LANGS.map((l) => ({ lang: l, href: new URL(route(page, l), site).href }));
const xDefault = new URL(route(page, DEFAULT_LANG), site).href;

// Las plataformas sociales exigen URL absoluta para la imagen.
const ogImage = new URL('/og.png', site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Le dice a Google qué versión mostrar según el idioma de quien busca. */}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="author" content="Diego Alvarez" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    {/* Color de la barra del navegador en móvil, según el tema del sistema. */}
    <meta name="theme-color" content="#f6f7f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101314" media="(prefers-color-scheme: dark)" />

    {/* Las fuentes empiezan a descargarse antes de que el CSS las pida. */}
    <link
      rel="preload"
      href="/fonts/switzer-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/switzer-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* --- Al compartir en redes y mensajería --- */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Diego Alvarez" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(UI.ogImageAlt, lang)} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[otherLang(lang)]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t(UI.ogImageAlt, lang)} />

    {/*
      Aplica la elección de tema antes del primer pintado; si no, quien
      tenga guardado el modo claro vería un destello oscuro al cargar.

      Solo escribe `data-theme` cuando alguien ha elegido a mano. Si nadie
      ha elegido, el atributo no existe y manda `prefers-color-scheme`
      desde el CSS — que es lo que hace que el sitio se vea bien aunque
      este script no llegue a ejecutarse.

      Si editas este script, actualiza el hash de la CSP en vercel.json;
      scripts/check-csp.mjs rompe la compilación si se te olvida.
    */}
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('dgo-tools-theme');
        } catch (e) {}
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      })();
    </script>
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-md bg-primary px-3 py-2 text-primary-foreground focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
    >
      {t(UI.skipToContent, lang)}
    </a>

    <Header lang={lang} page={page} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
