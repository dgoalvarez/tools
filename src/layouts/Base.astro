---
/**
 * Estructura común de todas las páginas: <head>, navegación, contenido
 * y pie.
 *
 * La navegación no es la misma en todas: la portada lleva una barra
 * superior fina, porque es la pantalla que se mira entera, y cada
 * herramienta lleva la barra lateral, que es a la vez su menú y la señal
 * de dónde está. Por eso aquí se elige una u otra según la página.
 *
 * Cada página existe en un solo idioma, declarado en <html lang>, y apunta
 * a su equivalente en el otro mediante hreflang.
 */
import { ClientRouter } from 'astro:transitions';
import BarraLateral from '../components/BarraLateral.astro';
import BarraMovil from '../components/BarraMovil.astro';
import Lanzador from '../components/Lanzador.astro';
import Footer from '../components/Footer.astro';
import { UI } from '../i18n/ui';
import { TOOLS } from '../i18n/tools';
import { ACENTO_POR_MATERIA, SOLIDO_POR_MATERIA } from '../i18n/labels';
import { t, otherLang, OG_LOCALE, DEFAULT_LANG, LANGS, type Lang } from '../i18n/config';
import { route, type PageKey } from '../i18n/routes';
import '../styles/global.css';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;

/** La herramienta abierta, o null en la portada. */
const herramienta = page === 'home' ? null : page;

/**
 * El acento de la página. Cada herramienta se pinta con el de su materia
 * y todo lo demás lo hereda; la portada usa el de la marca.
 */
const acento = herramienta
  ? ACENTO_POR_MATERIA[TOOLS[herramienta].etiquetas.materia]
  : 'var(--brand)';

/** El relleno de los botones principales. Va aparte del acento a propósito. */
const solido = herramienta
  ? SOLIDO_POR_MATERIA[TOOLS[herramienta].etiquetas.materia]
  : 'var(--l-brand)';

const site = Astro.site!;
const canonical = new URL(route(page, lang), site).href;

// Cada página declara dónde vive su equivalente en el otro idioma, y cuál
// es la que se muestra a quien no encaja en ninguno (x-default).
const alternates = LANGS.map((l) => ({ lang: l, href: new URL(route(page, l), site).href }));
const xDefault = new URL(route(page, DEFAULT_LANG), site).href;

// Las plataformas sociales exigen URL absoluta para la imagen.
const ogImage = new URL('/og.png', site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Le dice a Google qué versión mostrar según el idioma de quien busca. */}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="author" content="DGO" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    {/* Color de la barra del navegador en móvil, según el tema del sistema. */}
    <meta name="theme-color" content="#f6f7f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101314" media="(prefers-color-scheme: dark)" />

    {/* Las fuentes empiezan a descargarse antes de que el CSS las pida. */}
    <link
      rel="preload"
      href="/fonts/switzer-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/switzer-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* --- Al compartir en redes y mensajería --- */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DGO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={t(UI.ogImageAlt, lang)} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[otherLang(lang)]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t(UI.ogImageAlt, lang)} />

    {/*
      Aplica antes del primer pintado las tres cosas que no pueden esperar
      a que llegue el JavaScript de la página: el tema elegido, si el menú
      se queda abierto, y que hay JavaScript. Si no fuera antes, quien
      tenga guardado el modo claro vería un destello oscuro, el menú daría
      un salto de ancho, y los botones que necesitan JavaScript aparecerían
      de golpe empujando lo que tuvieran debajo.

      `data-theme` solo se escribe cuando alguien ha elegido a mano. Si
      nadie ha elegido, el atributo no existe y manda `prefers-color-scheme`
      desde el CSS — que es lo que hace que el sitio se vea bien aunque
      este script no llegue a ejecutarse.

      Se vuelve a aplicar en `astro:after-swap`: al cambiar de página, el
      enrutador sustituye los atributos del <html> por los del documento
      nuevo, que viene del servidor y no sabe nada de lo que hay guardado.
      Sin esto, la primera navegación apagaría el tema y plegaría el menú.
      `after-swap` corre antes de pintar, así que no se ve.

      Si editas este script, actualiza el hash de la CSP en vercel.json;
      scripts/check-csp.mjs rompe la compilación si se te olvida.
    */}
    <script is:inline>
      (function () {
        var raiz = document.documentElement;
        function aplicar() {
          raiz.dataset.js = '1';
          try {
            var tema = localStorage.getItem('dgo-tools-theme');
            if (tema === 'dark' || tema === 'light') raiz.dataset.theme = tema;
            else delete raiz.dataset.theme;
            if (localStorage.getItem('dgo-tools-riel') === 'abierto') raiz.dataset.riel = 'abierto';
            else delete raiz.dataset.riel;
          } catch (e) {}
        }
        aplicar();
        document.addEventListener('astro:after-swap', aplicar);
      })();
    </script>

    {/*
      El enrutador del cliente: al seguir un enlace del sitio, trae la
      página nueva y sustituye el contenido en vez de recargar el
      navegador entero.

      Es lo que quita el parpadeo en blanco entre herramientas. Y no es
      solo estético: en una recarga completa el navegador vuelve a montar
      las fuentes, el CSS y las islas de React, y ese hueco es justo donde
      se veía saltar la navegación.

      Sigue siendo un sitio de páginas: cada herramienta tiene su URL, su
      HTML completo y funciona sin JavaScript. Esto solo se pone por
      encima cuando puede.
    */}
    <ClientRouter />
  </head>

  <body style={`--acento: ${acento}; --solido: ${solido}`}>
    <a
      href="#main"
      class="sr-only rounded-md bg-primary px-3 py-2 text-primary-foreground focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
    >
      {t(UI.skipToContent, lang)}
    </a>

    {/*
      El riel está DENTRO del flujo, en una fila con el contenido, y no
      encima con `position: fixed`. Es lo que hace que desplegarlo corra
      la herramienta en vez de taparla: se lee un nombre sin perder de
      vista lo que se estaba mirando.

      En móvil el riel no se pinta y manda la barra de arriba con su hoja.
    */}
    <div class="marco">
      <BarraLateral lang={lang} abierta={herramienta} pagina={page} />

      <div class="flex min-w-0 flex-1 flex-col">
        <BarraMovil lang={lang} abierta={herramienta} pagina={page} />

        <main id="main" class="flex-1">
          <slot />
        </main>

        <Footer lang={lang} />
      </div>
    </div>

    <Lanzador lang={lang} pagina={page} />

    <script>
      import '../scripts/nav';
    </script>
  </body>
</html>
