---
/**
 * La página de la herramienta de contraste.
 *
 * `client:load` para que el HTML salga ya pintado del servidor. El estado
 * inicial es el mismo en el servidor y en el navegador —los colores por
 * defecto— así que la hidratación no encuentra ninguna diferencia; lo que
 * venga en el enlace se aplica justo después.
 *
 * Lo que explica la herramienta lo cuenta el paso a paso del botón «?»,
 * señalando cada control. Ahí va también la nota de que APCA todavía no se
 * puede citar como cumplimiento: no cambia lo que hay que hacer con este
 * color, cambia lo que se puede decir en una auditoría.
 */
import Tool from '../layouts/Tool.astro';
import Contrast from '../islands/Contrast';
import { UI } from '../i18n/ui';
import { t, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Tool lang={lang} tool="contrast">
  <Contrast client:load lang={lang} />

  <noscript>
    <p
      class="mt-6 max-w-[var(--measure)] rounded-lg border border-line bg-surface-2 p-4 text-[var(--fs-small)] text-ink-muted"
    >
      {t(UI.sinJs, lang)}
    </p>
  </noscript>
</Tool>
