---
/**
 * El riel: la navegación de escritorio.
 *
 * ---------------------------------------------------------------------
 * Por qué se pliega
 *
 * La barra de antes medía entre 272 y 340 px y estaba siempre abierta,
 * con el nombre y el resumen de cada herramienta. Con tres eso era una
 * guía; con seis es una pared, y con doce será una lista que hay que
 * leer entera para encontrar algo. Y todo ese ancho lo paga la
 * herramienta, que es lo que se ha venido a usar.
 *
 * Plegado son 4,25 rem de iconos. Se abre con el botón de arriba y **la
 * herramienta se corre**: no flota encima ni tapa nada, así que abrirlo
 * para leer un nombre no esconde lo que estabas mirando. Lo que se elija
 * se recuerda.
 *
 * ---------------------------------------------------------------------
 * El orden
 *
 * Marca, buscador, herramientas, idioma y tema. De arriba abajo por
 * frecuencia: la marca y el buscador son la salida, las herramientas son
 * el trabajo, y el idioma y el tema se tocan una vez en la vida — por eso
 * están al pie y no compitiendo con lo demás.
 */
import Icono from './Icono.astro';
import Marca from './Marca.astro';
import NavHerramientas from './NavHerramientas.astro';
import ThemeToggle from './ThemeToggle';
import { UI } from '../i18n/ui';
import { t, otherLang, LANG_NAME, type Lang } from '../i18n/config';
import { route, type PageKey, type ToolKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** La herramienta abierta, o null en la portada. */
  abierta: ToolKey | null;
  /** La página actual, para que el conmutador de idioma no salga de ella. */
  pagina: PageKey;
}

const { lang, abierta, pagina } = Astro.props;
const other = otherLang(lang);
---

<nav class="riel" aria-label={t(UI.navTools, lang)}>
  <div class="riel-marca">
    <a href={route('home', lang)} class="riel-logo" title={t(UI.siteName, lang)}>
      <Marca />
    </a>

    {/*
      El botón de plegar nace oculto: sin JavaScript no plegaría nada, y
      un botón que no responde es peor que uno que no está. Con el riel
      plegado la marca no cabe, así que este botón pasa a ser lo único de
      la fila y se centra solo.
    */}
    <button
      type="button"
      class="riel-plegar"
      data-riel-plegar
      aria-expanded="false"
      aria-label={t(UI.desplegarMenu, lang)}
      title={t(UI.desplegarMenu, lang)}
      data-desplegar={t(UI.desplegarMenu, lang)}
      data-plegar={t(UI.plegarMenu, lang)}
      hidden
    >
      <Icono nombre="barras" tamano={18} />
    </button>
  </div>

  {/* Sin JavaScript no abriría el buscador, así que también nace oculto. */}
  <button
    type="button"
    class="riel-item riel-buscar"
    data-bento
    title={t(UI.verTodas, lang)}
    hidden
  >
    <span class="icono"><Icono nombre="lupa" tamano={18} /></span>
    <span class="nombre">{t(UI.verTodas, lang)}</span>
  </button>

  <div class="riel-lista">
    <NavHerramientas lang={lang} abierta={abierta} />
  </div>

  <div class="riel-pie">
    <a
      href={route(pagina, other)}
      class="riel-item"
      lang={other}
      hreflang={other}
      title={t(UI.switchLanguage, lang)}
    >
      <span class="icono idioma">{LANG_NAME[other].slice(0, 2)}</span>
      <span class="nombre">{LANG_NAME[other]}</span>
    </a>

    <ThemeToggle
      client:load
      toDark={t(UI.toDarkMode, lang)}
      toLight={t(UI.toLightMode, lang)}
      conNombre
    />
  </div>
</nav>
