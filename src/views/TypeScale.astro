---
/**
 * La página de la herramienta de escala tipográfica.
 *
 * Mismo montaje que la de contraste: `client:load` para que el HTML salga
 * ya pintado del servidor, y un aviso para quien no tenga JavaScript.
 */
import Tool from '../layouts/Tool.astro';
import TypeScale from '../islands/TypeScale';
import { UI } from '../i18n/ui';
import { t, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Tool lang={lang} tool="scale">
  <TypeScale client:load lang={lang} />

  <noscript>
    <p
      class="mt-6 max-w-[var(--measure)] rounded-lg border border-line bg-surface-2 p-4 text-[length:var(--fs-small)] text-ink-muted"
    >
      {t(UI.sinJs, lang)}
    </p>
  </noscript>
</Tool>
