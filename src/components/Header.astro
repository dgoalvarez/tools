---
/**
 * Cabecera: la marca, las tres herramientas, el idioma y el tema.
 *
 * Todo es HTML salvo el conmutador de tema, que necesita JavaScript por
 * definición. Dos idiomas son dos enlaces y no merecen una isla.
 */
import ThemeToggle from './ThemeToggle';
import { UI } from '../i18n/ui';
import { TOOLS } from '../i18n/tools';
import { t, otherLang, LANG_NAME, type Lang } from '../i18n/config';
import { route, TOOL_KEYS, type PageKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const other = otherLang(lang);
---

<header class="border-b border-line">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-5 gap-y-2 px-[var(--pad-x)] py-3"
  >
    <a
      href={route('home', lang)}
      class="font-medium tracking-tight text-ink hover:text-brand"
      aria-current={page === 'home' ? 'page' : undefined}
    >
      {t(UI.brand, lang)}<span class="text-ink-soft"> · {t(UI.siteName, lang)}</span>
    </a>

    <nav aria-label={t(UI.navTools, lang)} class="flex flex-wrap items-center gap-x-4 gap-y-1">
      {
        TOOL_KEYS.map((key) => (
          <a
            href={route(key, lang)}
            aria-current={page === key ? 'page' : undefined}
            class="text-[var(--fs-small)] text-ink-muted hover:text-brand [&[aria-current=page]]:text-brand"
          >
            {t(TOOLS[key].name, lang)}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <a
        href={route(page, other)}
        lang={other}
        hreflang={other}
        title={t(UI.switchLanguage, lang)}
        class="rounded-md px-2 py-1 text-[var(--fs-small)] text-ink-muted hover:text-brand"
      >
        {LANG_NAME[other]}
      </a>

      <ThemeToggle
        client:load
        toDark={t(UI.toDarkMode, lang)}
        toLight={t(UI.toLightMode, lang)}
      />
    </div>
  </div>
</header>
