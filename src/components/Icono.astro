---
/**
 * Pinta uno de los iconos de Phosphor como SVG, sin JavaScript.
 *
 * Es decorativo por defecto (`aria-hidden`), porque un icono junto a su
 * texto solo lo repetiría para quien usa un lector de pantalla. Cuando el
 * icono va solo —un botón sin etiqueta— hay que pasarle un `titulo`, y
 * entonces sí se anuncia.
 */
import { ICONOS, VIEWBOX, type IconoKey } from './iconos';

interface Props {
  nombre: IconoKey;
  /** Tamaño en píxeles. El de fábrica es el que usa el menú. */
  tamano?: number;
  /** Si se pasa, el icono deja de ser decorativo y se anuncia con este texto. */
  titulo?: string;
  class?: string;
}

const { nombre, tamano = 20, titulo, class: clase } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={tamano}
  height={tamano}
  viewBox={VIEWBOX}
  fill="currentColor"
  class={clase}
  role={titulo ? 'img' : undefined}
  aria-hidden={titulo ? undefined : 'true'}
  aria-label={titulo}
  set:html={ICONOS[nombre]}
/>
