---
/**
 * La portada.
 *
 * Sin barra lateral y sin tope de 1152 px: es la pantalla que se mira
 * entera, así que el relleno crece con la ventana en vez de dejar una
 * franja muerta a los lados.
 *
 * ---------------------------------------------------------------------
 * Por qué el índice y no las tarjetas
 *
 * Había una rejilla de tarjetas, y cada tarjeta llevaba SIETE dispositivos
 * alrededor de una sola frase: rótulo de materia, chip de icono de 44 px,
 * nombre, resumen, rótulo de tarea, «Abrir →», y encima un halo radial, un
 * degradado y un borde teñido.
 *
 * Dos de esos siete contradecían al propio proyecto. `labels.ts` dice, con
 * estas palabras, que la materia y la tarea son «el modelo mental de quien
 * construye herramientas, no el de quien las usa». La tarjeta las ponía
 * las dos, una arriba y otra abajo, enmarcando el contenido. El riel, que
 * se diseñó después y mejor, no enseña ninguna.
 *
 * Y la jerarquía estaba del revés: el nombre —«Reloj»— se llevaba treinta
 * píxeles de altura y no dice nada; la frase, que es lo ÚNICO que explica
 * para qué sirve, iba en gris a 0,9 rem.
 *
 * Así que la portada pasa a ser lo que en realidad es: un índice. Una fila
 * por herramienta, el nombre y su frase del mismo tamaño y en la misma
 * línea, agrupadas por ámbito igual que en el riel. Se lee entera de
 * arriba abajo en diez segundos, y aguanta doce herramientas donde la
 * rejilla ya pedía scroll con siete.
 *
 * El color no se va: lo lleva el icono, que además es la misma marca que
 * se va a pulsar en el riel a partir de mañana. Lo que se va es el color
 * DECORATIVO — siete halos encendidos sobre un fondo casi negro, que es
 * exactamente el aspecto que tiene todo lo que se genera solo.
 *
 * El titular se queda como estaba. La contención es el argumento: siete
 * cosas, una frase cada una, y nada más. Eso es lo que dice el titular.
 *
 * Todo sale de src/i18n/tools.ts y src/i18n/labels.ts. Añadir una
 * herramienta ahí la añade aquí sin tocar este archivo.
 */
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import RampaViva from '../islands/RampaViva';
import { UI } from '../i18n/ui';
import { TOOLS } from '../i18n/tools';
import { AMBITOS, ORDEN_AMBITOS, ACENTO_POR_MATERIA, ambitoPrincipal } from '../i18n/labels';
import { t, type Lang } from '../i18n/config';
import { route, TOOL_KEYS } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/* Los mismos grupos y el mismo orden que el riel: quien llega por la
   portada y luego navega por la barra encuentra las cosas donde ya las
   había visto. */
const grupos = ORDEN_AMBITOS.map((ambito) => ({
  ambito,
  herramientas: TOOL_KEYS.filter((key) => ambitoPrincipal(TOOLS[key].etiquetas) === ambito),
})).filter((grupo) => grupo.herramientas.length > 0);
---

<Base
  lang={lang}
  page="home"
  title={t(UI.homeTitle, lang)}
  description={t(UI.siteDescription, lang)}
>
  <div class="mx-auto max-w-[1680px] px-[var(--pad-x)]">
    <section
      class="flex flex-wrap items-end gap-x-[clamp(2rem,4vw,6rem)] gap-y-8 py-[clamp(3rem,5.6vw,7rem)]"
    >
      <h1
        class="m-0 flex-[1_1_32rem] text-[length:clamp(3rem,5.6vw,6.75rem)] leading-[0.94] font-semibold tracking-[-0.048em] text-ink text-balance"
      >
        {t(UI.taglineInicio, lang)}{' '}
        <em class="text-[var(--acento)] not-italic">{t(UI.taglineAcento, lang)}</em>
      </h1>

      <div class="flex flex-[0_1_21rem] flex-col gap-3.5">
        <p class="m-0 text-[0.72rem] font-medium tracking-[0.1em] text-ink-soft uppercase">
          {t(UI.sello, lang)}
        </p>
        <p class="m-0 text-[1rem] leading-relaxed text-ink-muted">{t(UI.homeIntro, lang)}</p>
      </div>
    </section>

    {/*
      La franja va entre el titular y el índice, y ese sitio es el
      argumento entero: el párrafo de arriba PROMETE que todo se calcula
      aquí, y lo primero que se ve debajo es once colores que se acaban de
      calcular aquí. Ponerla más abajo la habría dejado como adorno; el
      párrafo se lee y a continuación se comprueba.

      `client:idle` y no `client:load` a propósito: el servidor ya manda
      la rampa derivada y las once casillas entran solas con una animación
      de CSS, así que el primer fotograma está completo y los 23 KB
      comprimidos de aritmética de color no tienen por qué competir con
      él. Lo que espera a la isla es solo lo vivo: sembrar otro tono.
    */}
    <section class="rampa-viva">
      <RampaViva client:idle />
      <p class="pie-rampa">{t(UI.rampaPie, lang)}</p>
    </section>

    <div class="indice pb-[clamp(2rem,3vw,3.5rem)]">
      {
        grupos.map((grupo) => (
          <section class="grupo-indice">
            <p class="rotulo-indice">{t(AMBITOS[grupo.ambito], lang)}</p>

            <ul class="lista-indice">
              {grupo.herramientas.map((key) => {
                const tool = TOOLS[key];
                return (
                  <li style={`--acento: ${ACENTO_POR_MATERIA[tool.etiquetas.materia]}`}>
                    <a href={route(key, lang)} class="fila-indice">
                      <span class="icono">
                        <Icono nombre={tool.icono} tamano={20} />
                      </span>
                      <span class="nombre">{t(tool.name, lang)}</span>
                      <span class="para">{t(tool.summary, lang)}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Base>
