# Guarda todo con saltos de línea LF en el repositorio.
# Sin esto, Windows introduce diferencias en archivos que nadie tocó.
* text=auto eol=lf

# Binarios: que git no intente convertirlos.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
